# Local agent cache docs (do not upload)

example/*
docs/local_agent_cache/*

# Build artifacts fetched from upstream are regenerated by CI, never committed.
pkgs/
binary/

# Packages inside src/ are inputs for a local `pica-pack build`; the published
# copies under r/packages/ are committed on purpose.
*.pkg.tar.gz
!r/packages/*.pkg.tar.gz

# CI workspace
build_output/
__pycache__/
*.pyc

# Schema cache
.schema-cache/

.codebuddy/*
.workbuddy/*

