pkgname = ttyd
appname = ttyd
os = openwrt
pica = 0.4.4
pkgdesc = A command-line tool for sharing terminal over the web.
url = https://github.com/tsl0922/ttyd
branch = master
protocol = cli
license = MIT
source_availability = open
packager = pica-pack
type = cli
targets = opkg

# The upstream package is the one installed; this source adds nothing to it.
app = ttyd

# The libraries it links against, declared so a device that lacks one is told
# which package is missing rather than getting a binary that will not start.
# libc is left out: it is in every image.
base = libcap
base = libopenssl3
base = libjson-c5
base = libuv1
base = zlib
base = libwebsockets-full
