{
  "$schema": "../../../ci/schema/build.schema.json",
  "matrix": [
    "x86_64",
    "aarch64_generic",
    "aarch64_cortex-a53",
    "mipsel_24kc"
  ],
  "source": {
    "type": "github",
    "repo": "miaoermua/openwrt-leigodacc-manager",
    "tag_regex": "^v?[0-9.]+$",
    "assets": [
      {
        "match": "^leigod-acc_.*_(x86_64|aarch64_generic|aarch64_cortex-a53|mipsel_24kc)\\.ipk$"
      },
      {
        "match": "^luci-app-leigod-acc_.*_all\\.ipk$"
      },
      {
        "match": "^luci-i18n-leigod-acc-zh-cn_.*_all\\.ipk$"
      }
    ]
  }
}
