{
  "$schema": "../../../ci/schema/build.schema.json",
  "matrix": [
    "x86_64",
    "aarch64_generic"
  ],
  "source": {
    "type": "github",
    "repo": "canmi21/vane",
    "tag_regex": "^v?[0-9.]+$",
    "arch_map": {
      "aarch64_generic": "aarch64"
    },
    "assets": [
      {
        "match": "^vane-v.*-openwrt-(x86_64|aarch64)\\.ipk$"
      }
    ]
  }
}
