{
  "$schema": "../../../ci/schema/build.schema.json",
  "matrix": [
    "all"
  ],
  "source": {
    "type": "github",
    "repo": "derisamedia/luci-theme-alpha",
    "tag_regex": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[0-9a-z.]+)?$",
    "prerelease": true,
    "assets": [
      {
        "match": "^luci-theme-alpha-[0-9].*\\.apk$"
      },
      {
        "match": "^luci-app-alpha-config-.*\\.apk$"
      }
    ]
  }
}
