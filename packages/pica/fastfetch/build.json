{
  "$schema": "../../../ci/schema/build.schema.json",
  "matrix": [
    "x86_64"
  ],
  "source": {
    "type": "archive",
    "url": "https://github.com/fastfetch-cli/fastfetch/releases/download/{version}/fastfetch-musl-{arch}.tar.gz",
    "arch_map": {
      "x86_64": "amd64"
    },
    "strip": 1,
    "include": [
      "usr/bin/",
      "usr/share/licenses/"
    ]
  },
  "upstream": "github:fastfetch-cli/fastfetch"
}
