{
  "schema": "pica-ci-job-v1",
  "mgr": "apk",
  "id": "luci-compat",
  "enabled": true,
  "manifest": "src/apk/luci-compat/manifest",
  "source": {
    "provider": "http_template",
    "url_templates": [
      "https://downloads.immortalwrt.org/releases/25.12.2/packages/{arch}/luci/luci-compat-26.236.50544~cb5d434.apk"
    ]
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "26.236.50544~cb5d434"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 1
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a72"
      },
      {
        "platform": "mipsel",
        "arch": "mipsel_24kc"
      }
    ],
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "registry_db": "r/apk/luci-compat/db.json",
    "keep_release_history": 1
  }
}
