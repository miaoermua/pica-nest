{
  "schema": "pica-ci-job-v1",
  "mgr": "pica",
  "id": "homebox",
  "enabled": true,
  "manifest": "src/pica/homebox/manifest",
  "source": {
    "provider": "tarball",
    "url_template": "https://github.com/XGHeaven/homebox/releases/download/v0.1.3/homebox-linux-{arch}-musl.tar.gz",
    "strip_components": 0,
    "rename": "homebox",
    "dest_subdir": "usr/sbin",
    "arch_map": {
      "x86_64": "amd64",
      "aarch64_generic": "arm64",
      "aarch64_cortex-a53": "arm64",
      "aarch64_cortex-a72": "arm64"
    }
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "0.1.3"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 1
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a72"
      }
    ],
    "include_dirs": [
      "scripts",
      "root"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "registry_db": "r/pica/homebox/db.json",
    "keep_release_history": 1
  }
}