{
  "schema": "pica-ci-job-v1",
  "mgr": "pica",
  "id": "tailscale-bin",
  "enabled": true,
  "manifest": "src/pica/tailscale-bin/manifest",
  "source": {
    "provider": "tarball",
    "url_template": "https://pkgs.tailscale.com/stable/tailscale_1.104.2_{arch}.tgz",
    "strip_components": 1,
    "dest_subdir": "usr/sbin",
    "include": [
      "tailscaled",
      "tailscale"
    ],
    "arch_map": {
      "x86_64": "amd64",
      "aarch64_generic": "arm64",
      "aarch64_cortex-a53": "arm64",
      "aarch64_cortex-a72": "arm64",
      "mipsel_24kc": "mipsle"
    }
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "1.104.2"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 1
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      }
    ],
    "include_dirs": [
      "scripts",
      "root"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "registry_db": "r/pica/tailscale-bin/db.json",
    "keep_release_history": 1
  }
}
