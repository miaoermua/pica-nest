{
  "schema": "pica-ci-job-v1",
  "mgr": "pica",
  "id": "cloudflared-bin",
  "enabled": true,
  "manifest": "src/pica/cloudflared-bin/manifest",
  "source": {
    "provider": "tarball",
    "url_template": "https://github.com/cloudflare/cloudflared/releases/download/2026.10.1/cloudflared-linux-{arch}",
    "rename": "cloudflared",
    "dest_subdir": "usr/sbin",
    "arch_map": {
      "x86_64": "amd64",
      "aarch64_generic": "arm64",
      "aarch64_cortex-a53": "arm64",
      "aarch64_cortex-a72": "arm64"
    }
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "2026.10.1"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 1
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      }
    ],
    "include_dirs": [
      "scripts",
      "root"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "registry_db": "r/pica/cloudflared-bin/db.json",
    "keep_release_history": 1
  }
}
