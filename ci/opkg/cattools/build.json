{
  "schema": "pica-ci-job-v1",
  "mgr": "opkg",
  "id": "cattools",
  "enabled": true,
  "manifest": "src/opkg/cattools/manifest",
  "source": {
    "provider": "tarball",
    "version": "a5d094c852bb31a5d266f6a0ac8946ded8a60f3f",
    "url_template": "https://raw.githubusercontent.com/miaoermua/cattools/{version}/cattools.sh",
    "rename": "cattools.sh",
    "dest_subdir": "usr/lib/pica/src/cattools"
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "1.1"
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "all",
        "arch": "all"
      }
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    },
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ]
  },
  "publish": {
    "registry_db": "r/opkg/cattools/db.json"
  }
}
