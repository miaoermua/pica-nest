{
  "schema": "pica-ci-job-v1",
  "mgr": "opkg",
  "id": "bind-dig",
  "enabled": true,
  "manifest": "src/opkg/bind-dig/manifest",
  "source": {
    "provider": "http_template",
    "version": "9.20.18-r1",
    "url_templates": [
      "https://downloads.immortalwrt.org/releases/24.10.0/packages/{arch}/packages/bind-dig_9.20.26-r1_{arch}.ipk"
    ],
    "arch_url_templates": {
      "aarch64_cortex-a53": [
        "https://downloads.immortalwrt.org/releases/24.10.0/packages/{arch}/packages/bind-dig_9.20.29-r1_aarch64_cortex-a53.ipk"
      ]
    }
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "9.20.18"
    },
    "pkgrel": {
      "from": "manifest",
      "fallback": 1
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a72"
      },
      {
        "platform": "mipsel",
        "arch": "mipsel_24kc"
      }
    ],
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "registry_db": "r/opkg/bind-dig/db.json"
  }
}
