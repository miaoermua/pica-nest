{
  "schema": "pica-ci-job-v1",
  "mgr": "opkg",
  "id": "openlist",
  "enabled": true,
  "manifest": "src/opkg/openlist/manifest",
  "source": {
    "provider": "http_template",
    "url_templates": [
      "https://downloads.immortalwrt.org/releases/24.10.0/packages/{arch}/packages/openlist_4.1.10-r1_{arch}.ipk",
      "https://downloads.immortalwrt.org/releases/24.10.0/packages/{arch}/luci/luci-app-openlist_26.126.28706~6ac4a03_all.ipk",
      "https://downloads.immortalwrt.org/releases/24.10.0/packages/{arch}/luci/luci-i18n-openlist-zh-cn_26.176.74839~949c5b0_all.ipk",
      "https://downloads.immortalwrt.org/releases/24.10.0/packages/{arch}/luci/luci-i18n-openlist-zh-cn_26.228.65014~8e278ba_aarch64_cortex-a53.ipk"
    ],
    "version": "4.1.5-r1"
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "4.1.5"
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "amd64",
        "arch": "x86_64"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a72"
      },
      {
        "platform": "mipsel",
        "arch": "mipsel_24kc"
      }
    ],
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "registry_db": "r/opkg/openlist/db.json"
  }
}
