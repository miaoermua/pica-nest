{
  "schema": "pica-ci-job-v1",
  "mgr": "opkg",
  "id": "ua-mask",
  "enabled": true,
  "manifest": "src/opkg/ua-mask/manifest",
  "source": {
    "provider": "github",
    "repo": "Zesuy/UA-Mask",
    "release": {
      "tag": {
        "mode": "regex",
        "regex": "^v0\\.4\\.3$"
      },
      "allow_prerelease": false,
      "assets": [
        {
          "name": "ua-mask-pkg",
          "role": "app",
          "regex": "^UAmask_[0-9].*-r?[0-9]+[_-]([A-Za-z0-9_+.-]+)\\.ipk$",
          "required": true,
          "capture_to": {
            "arch": 1
          }
        }
      ]
    }
  },
  "versioning": {
    "pkgver": {
      "from": "manifest",
      "fallback": "0.4.3"
    }
  },
  "build": {
    "matrix": [
      {
        "platform": "arm64",
        "arch": "aarch64_generic"
      },
      {
        "platform": "arm64",
        "arch": "aarch64_cortex-a53"
      }
    ],
    "include_dirs": [
      "scripts",
      "root",
      "pkgs"
    ],
    "pack": {
      "tool": "pica-pack",
      "format": "pkg.tar.gz"
    }
  },
  "publish": {
    "registry_db": "r/opkg/ua-mask/db.json"
  }
}
