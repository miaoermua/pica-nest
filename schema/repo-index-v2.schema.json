{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pica.community/schema/repo-index-v2.schema.json",
  "title": "Pica repository index",
  "description": "The index `pica -S` downloads from <repo>/repo.json. Mirrors crates/pica-pkg-core/src/repo.rs: REPO_SCHEMA, SUPPORTED_PKGMGRS and the required fields enforced by validate().",
  "type": "object",
  "required": ["schema", "packages"],
  "properties": {
    "schema": {
      "const": 2,
      "description": "Must equal REPO_SCHEMA in pica-pkg-core."
    },
    "repo_name": { "type": "string" },
    "repo_desc": { "type": "string" },
    "generated_at": { "type": "string" },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "description": "Optional fields mirror Option<T> in repo.rs. pica-pack serializes an absent option as null, and pica-pkg-core accepts null, so null is valid for every property that is not required.",
      "required": [
        "pkgname",
        "pkgver",
        "pkgrel",
        "pkgmgr",
        "platform",
        "arch",
        "filename",
        "sha256"
      ],
      "properties": {
        "pkgname": { "type": "string", "minLength": 1 },
        "appname": {
          "type": ["string", "null"],
          "description": "Selector a user types. Falls back to pkgname when empty."
        },
        "pkgver": { "type": "string", "minLength": 1 },
        "pkgrel": { "type": "string", "minLength": 1 },
        "pkgmgr": {
          "enum": ["opkg", "apk", "pica"],
          "description": "Which backend owns the files. Part of a package's identity: one application may be published once per backend."
        },
        "os": { "type": ["string", "null"] },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "uname": { "type": ["string", "null"] },
        "filename": {
          "type": "string",
          "pattern": "\\.pkg\\.tar\\.gz$",
          "description": "Must equal package_filename() output: <pkgname>-<pkgver>-<pkgrel>[-<platform>]-<arch>[-apk|-pica].pkg.tar.gz"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "size": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Unpacked size of root/ in bytes."
        },
        "csize": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Compressed archive size in bytes."
        },
        "branch": { "type": ["string", "null"] },
        "protocol": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "origin": { "type": ["string", "null"] },
        "luci_url": { "type": ["string", "null"] },
        "luci_desc": { "type": ["string", "null"] },
        "pkgdesc": { "type": ["string", "null"] },
        "license": { "type": ["string", "null"] },
        "visibility": { "enum": ["open", "mix", "closed", null] },
        "pica": { "type": ["string", "null"] },
        "download_url": { "type": ["string", "null"] },
        "manifest": {
          "type": ["object", "null"],
          "description": "The package's own manifest, verbatim. Repeated fields such as app/base/kmod appear as arrays of strings.",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}